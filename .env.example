# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Telegram user_id администраторов через запятую (узнать можно у @userinfobot)
ADMIN_IDS=111111111,222222222

# DSN базы данных (async SQLAlchemy). По умолчанию — файл SQLite в ./data
DATABASE_URL=sqlite+aiosqlite:///data/messages.db

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Сколько записей показывать по умолчанию в /history, /deleted, поиске
PAGE_SIZE=20

# --- Userbot (Telethon) для АВТОМАТИЧЕСКОГО детекта удалений ---
# Необязательно. Если не заполнять — работает только режим бота.
# Получить api_id и api_hash: https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# Файл сессии Telethon (в каталоге data, чтобы переживал перезапуск контейнера)
USERBOT_SESSION=data/userbot
