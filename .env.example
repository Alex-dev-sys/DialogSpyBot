# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Telegram user_id администраторов через запятую (узнать можно у @userinfobot)
ADMIN_IDS=111111111,222222222

# DSN базы данных (async SQLAlchemy). По умолчанию — файл SQLite в ./data
DATABASE_URL=sqlite+aiosqlite:///data/messages.db

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Сколько записей показывать по умолчанию в /history, /deleted, поиске
PAGE_SIZE=20
